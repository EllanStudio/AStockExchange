# Generate independent high-entropy values before first launch.
ASTOCK_DB_PASSWORD=replace-with-a-long-random-database-password
ASTOCK_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
ASTOCK_API_KEY=replace-with-a-long-random-service-api-key

# mock is deterministic and safe for development. eastmoney is an optional
# development/non-commercial adapter with no SLA; assess display rights first.
ASTOCK_DATA_PRIMARY=mock
ASTOCK_DATA_FALLBACK=

# Keep true in production. Set false only for round-the-clock development tests.
ASTOCK_ENFORCE_SESSIONS=true
ASTOCK_PORT=8787
