# Generate independent high-entropy values before first launch.
ASTOCK_DB_PASSWORD=replace-with-a-long-random-database-password
ASTOCK_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
ASTOCK_API_KEY=replace-with-a-long-random-service-api-key

# mock is deterministic and safe for development. longbridge covers CN/HK/US;
# create OpenAPI credentials and confirm quote/display rights before enabling it.
ASTOCK_DATA_PRIMARY=mock
ASTOCK_DATA_FALLBACK=
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
# Use cn for mainland-China network routing; hk keeps the global endpoint.
LONGBRIDGE_REGION=hk

# Game-economy conversion rates. These are deliberately operator controlled and
# are not fetched from a foreign-exchange feed.
ASTOCK_RATE_CNY=100
ASTOCK_RATE_HKD=100
ASTOCK_RATE_USD=700

# Keep true in production. Set false only for round-the-clock development tests.
ASTOCK_ENFORCE_SESSIONS=true
ASTOCK_PORT=8787
